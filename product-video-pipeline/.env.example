# Copy to .env and fill in to use the real HeyGen API instead of the mock.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Optional: only needed if you want the admin page to turn your uploaded
# narration script + documents/directions into a scene plan via Gemini.
# Leave blank to fall back to a naive paragraph split (clearly flagged as such).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
